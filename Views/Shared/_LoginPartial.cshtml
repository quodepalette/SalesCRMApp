@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav account-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item"><a id="manage" class="nav-link account-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage your account">@UserManager.GetUserName(User)</a></li>
    <li class="nav-item">
        <form id="logoutForm" class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button id="logout" type="submit" class="btn btn-sm btn-outline-secondary logout-button">Sign out</button>
        </form>
    </li>
}
else
{
    <li class="nav-item"><a class="nav-link account-link" id="login" asp-area="Identity" asp-page="/Account/Login">Sign in</a></li>
    <li class="nav-item"><a class="btn btn-sm btn-primary nav-register" id="register" asp-area="Identity" asp-page="/Account/Register">Create account</a></li>
}
</ul>
